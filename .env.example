# Nebius Token Factory (OpenAI-compatible). Create a key in the Nebius console.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-north1.nebius.com/v1/
# Pick an id from `npm run spike:models` (also set it in agents/futureme.yaml)
NEBIUS_MODEL=nvidia/Nemotron-3.5-Super-VL

# Nemotron reasoning: "auto" lets each agent choose (planners and judges think, quick voices don't); "on" or "off" forces it.
NEBIUS_REASONING=auto

# Chat runs through Docker Agent when this is set (`npm run agent:serve`, e.g. http://127.0.0.1:8083). Leave empty to run
# the team in the app on Nemotron, with per-agent reasoning, structured outputs, parallel tools, live reasoning and photos.
DOCKER_AGENT_URL=
# Set to "mock" to use the built-in stand-in model instead of Nebius (also the default when NEBIUS_API_KEY is empty).
LLM_PROVIDER=

# Jev by TypeSafe AI: the decision layer for Future Simulator routes (docs/decision-layer.md). Optional: without a key,
# decisions show the rules' checks only, marked "pending". The key can also be saved in Settings > Decision model.
TYPESAFE_API_KEY=
# A versioned id keeps decisions reproducible; "jev-latest" follows TypeSafe's current release.
TYPESAFE_MODEL=jev-1.13.0
TYPESAFE_BASE_URL=https://api.typesafe.ai
# Per-request timeout and attempts (retries only on timeouts, 408, 429, 5xx and 529).
JEV_TIMEOUT_MS=8000
JEV_MAX_ATTEMPTS=3
# "off" silences the one-line JSON log per Jev call (it never contains the key or the state sent).
JEV_LOG=

# Docker MCP tools for the agent (docs/docker-mcp.md). Leave empty to run without them.
# After `docker mcp gateway run --transport streaming --port 8811`:
DOCKER_MCP_GATEWAY_URL=
DOCKER_MCP_GATEWAY_TOKEN=
# Tool names that may run without your approval even though they don't say they're read-only
DOCKER_MCP_AUTO_APPROVE=

# The agent's integrations (docs/integrations.md). All optional; reading runs on its own, sending and changing waits
# for your approval on the Agent page.
# Google (Gmail + Calendar): an OAuth client from Google Cloud, then "Connect Google" on the Agent page.
# Redirect URI: <your address>/api/integrations/google/callback. Or paste a refresh token you made in GOOGLE_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Any other mailbox over IMAP and SMTP (use an app password). EMAIL_PROVIDER=gmail|imap|agentmail picks one.
EMAIL_IMAP_HOST=
EMAIL_SMTP_HOST=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_PROVIDER=
# Read-only calendar feeds (secret iCal addresses), comma-separated
CALENDAR_ICS_URLS=
# Chat channels the agent may post to, after approval
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Tools that may run without asking, e.g. add_task,calendar_create_event (email_send and send_message always ask)
AGENT_AUTO_APPROVE=

# Local storage (defaults shown). The app and the MCP server must point at the same files.
VAULT_DIR=./data/vault
DATABASE_PATH=./data/futureme.db
# Cloud copy of the database and files in Supabase (docs/supabase.md). Leave SUPABASE_URL empty to keep everything local.
# The secret key is server-only: never put it in a NEXT_PUBLIC_ variable or ship it to the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Seconds between pushes for `npm run cloud-sync -- --loop` (default 30). CLOUD_PROVIDER=off turns the cloud copy off.
CLOUD_SYNC_INTERVAL=

# Web research (server only). DuckDuckGo by default, but it blocks most cloud servers. Set a You.com key (YDC_API_KEY) or a
# Brave Search key for a sturdier API; You.com wins when both are set. WEB_SEARCH=off disables both web tools.
YDC_API_KEY=
BRAVE_SEARCH_API_KEY=
WEB_SEARCH=

# Night shift: daily run time in server time for `npm run night-shift -- --loop` (and the Docker image). "off" disables it.
NIGHT_SHIFT_AT=05:30

# Private local mode: LLM_PROVIDER=local uses Docker Model Runner (or any OpenAI-compatible local server).
LOCAL_LLM_URL=http://localhost:12434/engines/v1
LOCAL_MODEL=ai/qwen3

# Voice twin engines. Keys can also be added under "Voice engine" on /twin; one set here wins over the app's.
ELEVENLABS_API_KEY=
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=
# Encrypts the keys saved in the app (default: a random secret.key made next to the database). Changing it means
# entering those keys again.
FUTUREME_SECRET=
# Where consent recordings and voice samples are kept (default: a "voice" folder next to the database)
TWIN_DATA_DIR=
# Calls with your twin. ElevenLabs calls back into TOMORA for every reply, so it needs the app's public https address.
TWIN_PUBLIC_URL=
# Secret ElevenLabs sends with each of those requests (default: generated and stored in the database)
TWIN_LLM_SECRET=
# A Twilio number imported into ElevenLabs, for calls to your own phone
ELEVENLABS_PHONE_NUMBER_ID=
# The voice model on calls (default eleven_v4_turbo, expressive; eleven_flash_v2_5 is a little faster)
TWIN_VOICE_MODEL=
# "off" stops the Docker image from running the twin's call scheduler
TWIN_SCHEDULER=
# The twin's own email inbox (AgentMail). Leave empty to keep its email switched off.
AGENTMAIL_API_KEY=
# Use an inbox you already made instead of creating one, or pick the username of a new one
AGENTMAIL_INBOX_ID=
AGENTMAIL_USERNAME=
# Signing secret of the AgentMail webhook pointed at /api/twin/email (mail isn't received without it)
AGENTMAIL_WEBHOOK_SECRET=
# Public launch. With TWIN_PUBLIC_URL set the app is on the internet: set an access code so only you can open it.
FUTUREME_ACCESS_CODE=
# Countries the twin may call, as ISO codes (default: every country it knows), and contacts' calling hours in their time
TWIN_CALL_COUNTRIES=
TWIN_CALL_HOURS=8-21
# Days to keep what other people said (call transcripts and recordings, received mail)
TWIN_RETENTION_DAYS=30
# Monthly cost cap in US dollars, and the estimated prices it counts
TWIN_MONTHLY_BUDGET=20
TWIN_COST_PER_MINUTE=0.10
TWIN_COST_PER_EMAIL=0.001

# Connected accounts (docs/social-connectors.md). Importing LinkedIn, X and Facebook data exports needs nothing here.
# Key that encrypts saved sign-in tokens (any long random string). Default: a random key in secret.key next to the database.
FUTUREME_SECRET_KEY=
# The app's public address, for OAuth redirects (default: TWIN_PUBLIC_URL, then the address the browser used)
FUTUREME_PUBLIC_URL=
# Optional "Sign in with" buttons. Redirect URL to register: <public address>/api/connections/oauth/<x|linkedin|facebook>/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v24.0
# Optional "Fetch public profile" for Instagram, TikTok, YouTube, X, LinkedIn and Facebook Pages, through Apify's MCP
# server (mcp.apify.com). Only accounts that carry a one-time code from TOMORA are fetched. Each run is capped at $0.25.
APIFY_TOKEN=
# mcp (default, falls back to REST) or rest
APIFY_TRANSPORT=mcp

# Multi-user demo servers (FUTUREME_MULTI_USER=1): spending limits per UTC day. Defaults in multi-user mode shown; 0 = off.
FUTUREME_DAILY_CALLS=120
FUTUREME_DAILY_TOKENS=250000
FUTUREME_SERVER_DAILY_TOKENS=3000000
# How many workspaces sign-in will create (returning visitors with a workspace code always get in).
FUTUREME_MAX_WORKSPACES=300

# Voice for judges on a shared demo server: put one ElevenLabs key on the server (ELEVENLABS_API_KEY, used by every
# workspace) and keep it cheap. Each person can talk in a ready-made voice (no cloning) or clone their own.
TWIN_PRESET_VOICE_ID=
TWIN_MAX_CALL_SECONDS=180
TWIN_DAILY_VOICE_CALLS=3
TWIN_SERVER_DAILY_VOICE_CALLS=30
TWIN_VOICE_TTL_DAYS=3
