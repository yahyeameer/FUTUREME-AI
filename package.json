{
  "name": "futureme-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "spike": "tsx --env-file-if-exists=.env.local scripts/spike-nebius.ts",
    "spike:models": "tsx --env-file-if-exists=.env.local scripts/spike-nebius.ts models",
    "mcp": "tsx mcp/futureme-server.ts",
    "mock-model": "tsx scripts/mock-model-server.ts",
    "agent:serve": "docker agent serve chat agents/futureme.yaml --safety autonomous",
    "night-shift": "tsx --env-file-if-exists=.env.local scripts/night-shift.ts",
    "twin-scheduler": "tsx --env-file-if-exists=.env.local scripts/twin-scheduler.ts",
    "pack": "tsx scripts/pack.ts",
    "test:e2e": "playwright test",
    "seed:demo": "tsx --env-file-if-exists=.env.local scripts/seed-demo.ts"
  },
  "dependencies": {
    "@elevenlabs/react": "^1.18.0",
    "@hookform/resolvers": "^5.9.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.2",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "next": "16.4.0",
    "openai": "^7.33.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "license": "Apache-2.0"
}
